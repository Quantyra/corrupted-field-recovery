import CorruptedFieldRecovery.S010BalanceGaussianArrayGreedySpan
import CorruptedFieldRecovery.BinaryTensor
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Algebra.Polynomial.OfFn
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.LinearAlgebra.LinearIndependent.Lemmas

namespace CorruptedFieldRecovery

/-! # Quotient orbit growth for the accepted physical-unit selector

This is a dependency-clean continuation of the array selector.  It imports
the accepted augmented-array span/selector result, but does not import the
older RawGreedyModuleBasis, DynamicSpan, or quotient-orbit draft chain.
The selector step below returns an actual selected index and derives the
dimension/invariance of the abstract span obtained by adjoining its orbit.
It does not yet prove the Array-append span refinement or the three-pass
state induction; those remain explicit gaps. -/

/-- The first `s` powers of an operator applied to a vector. -/
def actualGreedyOrbitFamily {n s : Nat}
    (T : Module.End (ZMod 2) (BinaryVector n)) (v : BinaryVector n) :
    Fin s → BinaryVector n := fun i => (T ^ i.val) v

/-- The submodule generated by the finite operator orbit. -/
def actualGreedyOrbitSpan {n s : Nat}
    (T : Module.End (ZMod 2) (BinaryVector n)) (v : BinaryVector n) :
    Submodule (ZMod 2) (BinaryVector n) :=
  Submodule.span (ZMod 2) (Set.range (actualGreedyOrbitFamily (s := s) T v))

/-- The orbit family after passing to the quotient by an invariant submodule. -/
def actualGreedyQuotientOrbitFamily {n s : Nat}
    (T : Module.End (ZMod 2) (BinaryVector n))
    (M : Submodule (ZMod 2) (BinaryVector n)) (v : BinaryVector n) :
    Fin s → BinaryVector n ⧸ M :=
  fun i => M.mkQ ((T ^ i.val) v)

/-- A `T`-invariant submodule is preserved by evaluation of every polynomial
at `T`. -/
theorem actualGreedyInvariant_aeval_mem {n : Nat}
    (T : Module.End (ZMod 2) (BinaryVector n))
    (M : Submodule (ZMod 2) (BinaryVector n))
    (hT : ∀ x, x ∈ M → T x ∈ M)
    (x : BinaryVector n) (hx : x ∈ M) (q : Polynomial (ZMod 2)) :
    (Polynomial.aeval T q) x ∈ M := by
  have hpow : ∀ k y, y ∈ M → (T ^ k) y ∈ M := by
    intro k
    induction k with
    | zero => intro y hy; simpa using hy
    | succ k ih =>
        intro y hy
        rw [pow_succ, Module.End.mul_apply]
        exact ih (T y) (hT y hy)
  induction q using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [map_add]
      change ((Polynomial.aeval T p) x + (Polynomial.aeval T q) x) ∈ M
      exact M.add_mem hp hq
  | monomial k a =>
      rw [Polynomial.aeval_monomial, Module.End.mul_apply,
        Module.algebraMap_end_apply]
      exact M.smul_mem a (hpow k x hx)

/-- Bezout's identity contradicts an outside vector when a lower-degree
polynomial sends it into an invariant submodule and a degree-`s` polynomial
annihilates the operator. -/
theorem actualGreedyBezout_forces_mem {n : Nat}
    (T : Module.End (ZMod 2) (BinaryVector n))
    (M : Submodule (ZMod 2) (BinaryVector n))
    (hT : ∀ x, x ∈ M → T x ∈ M)
    (v : BinaryVector n) (hv : v ∉ M)
    (a b q p : Polynomial (ZMod 2))
    (hbezout : a * q + b * p = 1)
    (hroot : Polynomial.aeval T p = 0)
    (hqv : (Polynomial.aeval T q) v ∈ M) : False := by
  have hpoly := fun r y hy => actualGreedyInvariant_aeval_mem T M hT y hy r
  have hidentity :
      Polynomial.aeval T a * Polynomial.aeval T q +
        Polynomial.aeval T b * Polynomial.aeval T p = 1 := by
    calc
      _ = Polynomial.aeval T (a * q + b * p) := by simp
      _ = Polynomial.aeval T 1 := congrArg (Polynomial.aeval T) hbezout
      _ = 1 := by simp
  have hfirst : (Polynomial.aeval T a) ((Polynomial.aeval T q) v) ∈ M :=
    hpoly a _ hqv
  have hrootv : (Polynomial.aeval T p) v = 0 := by
    rw [hroot]
    simp
  have happly := congrArg
    (fun f : Module.End (ZMod 2) (BinaryVector n) => f v) hidentity
  have hresult : (Polynomial.aeval T a) ((Polynomial.aeval T q) v) = v := by
    simpa [Pi.add_apply, Module.End.mul_apply, hrootv] using happly
  exact hv (hresult ▸ hfirst)

/-- A nonzero polynomial of degree below an irreducible polynomial is
coprime to it. -/
theorem actualGreedyLowerDegree_bezout
    {p q : Polynomial (ZMod 2)} {s : Nat}
    (hirr : Irreducible p) (hpdeg : p.natDegree = s)
    (hqne : q ≠ 0) (hqdeg : q.natDegree < s) :
    ∃ a b, a * q + b * p = 1 := by
  have hnotdvd : ¬ p ∣ q := by
    intro hdiv
    have hle := Polynomial.natDegree_le_of_dvd hdiv hqne
    rw [hpdeg] at hle
    omega
  have hcoprime : IsCoprime p q := hirr.coprime_iff_not_dvd.mpr hnotdvd
  rcases hcoprime with ⟨a, b, hab⟩
  refine ⟨b, a, ?_⟩
  simpa [add_comm, mul_comm] using hab

/-- The first `s` quotient-orbit classes are linearly independent and span an
`s`-dimensional subspace.  The hypotheses are the irreducible degree-`s`
annihilator, invariance of `M`, and `v ∉ M`; no quotient field structure is
assumed. -/
theorem actualGreedyQuotientOrbit_independent
    {n s : Nat}
    (T : Module.End (ZMod 2) (BinaryVector n))
    (M : Submodule (ZMod 2) (BinaryVector n))
    (v : BinaryVector n) (p : Polynomial (ZMod 2))
    (hs : 1 ≤ s) (hpdeg : p.natDegree = s)
    (hirr : Irreducible p)
    (hroot : Polynomial.aeval T p = 0)
    (hT : ∀ x, x ∈ M → T x ∈ M) (hv : v ∉ M) :
    LinearIndependent (ZMod 2) (actualGreedyQuotientOrbitFamily (s := s) T M v) ∧
      Module.finrank (ZMod 2)
        (Submodule.span (ZMod 2)
          (Set.range (actualGreedyQuotientOrbitFamily (s := s) T M v))) = s := by
  classical
  have hLI : LinearIndependent (ZMod 2)
      (actualGreedyQuotientOrbitFamily (s := s) T M v) := by
    rw [Fintype.linearIndependent_iff]
    intro coeff hrel
    by_contra hcoeff
    have hnonzero : ∃ j : Fin s, coeff j ≠ 0 := by
      by_contra hnone
      apply hcoeff
      intro j
      by_contra hj
      exact hnone ⟨j, hj⟩
    obtain ⟨j, hj⟩ := hnonzero
    let q : Polynomial (ZMod 2) := Polynomial.ofFn s coeff
    have hqEval : (Polynomial.aeval T q) v =
        ∑ i : Fin s, coeff i • ((T ^ i.val) v) := by
      change (Polynomial.aeval T (Polynomial.ofFn s coeff)) v = _
      rw [Polynomial.ofFn_eq_sum_monomial]
      simp [map_sum, Polynomial.aeval_monomial,
        Module.End.mul_apply, Module.algebraMap_end_apply]
    have hsum : ∑ i : Fin s, coeff i • ((T ^ i.val) v) ∈ M := by
      have hmk : (M.mkQ)
          (∑ i : Fin s, coeff i • ((T ^ i.val) v)) = 0 := by
        simpa [actualGreedyQuotientOrbitFamily, map_sum, map_smul] using hrel
      exact (Submodule.Quotient.mk_eq_zero M).1 hmk
    have hqv : (Polynomial.aeval T q) v ∈ M := by
      rw [hqEval]
      exact hsum
    have hqne : q ≠ 0 := by
      intro hqzero
      have hcoeffzero : coeff = 0 :=
        Polynomial.injective_ofFn s (by simpa [q] using hqzero)
      exact hj (congrFun hcoeffzero j)
    have hqdeg : q.natDegree < s := by
      simpa [q] using Polynomial.ofFn_natDegree_lt hs coeff
    obtain ⟨a, b, hbezout⟩ := actualGreedyLowerDegree_bezout
      hirr hpdeg hqne hqdeg
    exact actualGreedyBezout_forces_mem T M hT v hv a b q p
      hbezout hroot hqv
  refine ⟨hLI, ?_⟩
  rw [finrank_span_eq_card hLI]
  simp

/-- The physical orbit is independent whenever its quotient classes are. -/
theorem actualGreedyOrbit_linearIndependent_of_quotient
    {n s : Nat} (T : Module.End (ZMod 2) (BinaryVector n))
    (M : Submodule (ZMod 2) (BinaryVector n)) (v : BinaryVector n)
    (hquot : LinearIndependent (ZMod 2)
      (actualGreedyQuotientOrbitFamily (s := s) T M v)) :
    LinearIndependent (ZMod 2) (actualGreedyOrbitFamily (s := s) T v) := by
  apply LinearIndependent.of_comp (M.mkQ)
  simpa [actualGreedyOrbitFamily, actualGreedyQuotientOrbitFamily] using hquot

/-- The orbit span intersects the old submodule trivially under quotient
independence. -/
theorem actualGreedyOrbitSpan_disjoint_of_quotient
    {n s : Nat} (T : Module.End (ZMod 2) (BinaryVector n))
    (M : Submodule (ZMod 2) (BinaryVector n)) (v : BinaryVector n)
    (hquot : LinearIndependent (ZMod 2)
      (actualGreedyQuotientOrbitFamily (s := s) T M v)) :
    Disjoint M (actualGreedyOrbitSpan (s := s) T v) := by
  rw [Submodule.disjoint_def]
  intro x hxM hxO
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hxO
  have hxQ : (M.mkQ) x = 0 :=
    (Submodule.Quotient.mk_eq_zero M).2 hxM
  have hrel : c.sum (fun i a => a • actualGreedyQuotientOrbitFamily (s := s) T M v i) = 0 := by
    rw [← hc] at hxQ
    simpa [map_finsuppSum, map_smul, actualGreedyOrbitFamily,
      actualGreedyQuotientOrbitFamily] using hxQ
  have hc0 : c = 0 := (linearIndependent_iff.mp hquot) c hrel
  rw [← hc, hc0]
  simp

/-- Quotient independence yields exact `s`-dimensional growth when the orbit
span is adjoined to the old submodule. -/
theorem actualGreedyOrbitAppend_finrank
    {n s : Nat} (T : Module.End (ZMod 2) (BinaryVector n))
    (M : Submodule (ZMod 2) (BinaryVector n)) (v : BinaryVector n)
    (hquot : LinearIndependent (ZMod 2)
      (actualGreedyQuotientOrbitFamily (s := s) T M v)) :
    Module.finrank (ZMod 2)
        (show Submodule (ZMod 2) (BinaryVector n) from
          M ⊔ (actualGreedyOrbitSpan (s := s) T v)) =
      Module.finrank (ZMod 2) M + s := by
  have hLI := actualGreedyOrbit_linearIndependent_of_quotient T M v hquot
  have hdim : Module.finrank (ZMod 2) (actualGreedyOrbitSpan (s := s) T v) = s := by
    rw [actualGreedyOrbitSpan, finrank_span_eq_card hLI]
    simp
  have hdisj := actualGreedyOrbitSpan_disjoint_of_quotient T M v hquot
  have hfin := Submodule.finrank_sup_add_finrank_inf_eq M
    (actualGreedyOrbitSpan (s := s) T v)
  rw [hdisj.eq_bot, finrank_bot, add_zero] at hfin
  rw [hfin, hdim]

/-- A monic degree-`s` annihilating polynomial reduces the last iterate to
the preceding orbit span. -/
theorem actualGreedyOrbit_last_mem_span
    {n s : Nat} (T : Module.End (ZMod 2) (BinaryVector n))
    (v : BinaryVector n) (p : Polynomial (ZMod 2))
    (hmonic : p.Monic) (hdeg : p.natDegree = s)
    (hroot : Polynomial.aeval T p = 0) :
    (T ^ s) v ∈ actualGreedyOrbitSpan (s := s) T v := by
  classical
  have hcoeff : p.coeff s = 1 := by
    rw [← hdeg, Polynomial.coeff_natDegree]
    exact hmonic.leadingCoeff
  have hsum :
      (∑ i ∈ Finset.range s, p.coeff i • T ^ i) + T ^ s = 0 := by
    rw [Polynomial.aeval_eq_sum_range' (show p.natDegree < s + 1 by omega) T]
      at hroot
    rw [Finset.sum_range_succ, hcoeff, one_smul] at hroot
    exact hroot
  have hvsum :
      (∑ i ∈ Finset.range s, p.coeff i • ((T ^ i) v)) + (T ^ s) v = 0 := by
    have hv := congrArg
      (fun f : Module.End (ZMod 2) (BinaryVector n) => f v) hsum
    simpa [Pi.add_apply, Pi.smul_apply] using hv
  have hlow :
      (∑ i ∈ Finset.range s, p.coeff i • ((T ^ i) v)) ∈
        actualGreedyOrbitSpan (s := s) T v := by
    apply (actualGreedyOrbitSpan (s := s) T v).sum_smul_mem
    intro i hi
    apply Submodule.subset_span
    exact ⟨⟨i, Finset.mem_range.mp hi⟩, by simp [actualGreedyOrbitFamily]⟩
  have hlast : (T ^ s) v = - (∑ i ∈ Finset.range s,
      p.coeff i • ((T ^ i) v)) := eq_neg_of_add_eq_zero_right hvsum
  rw [hlast]
  exact (actualGreedyOrbitSpan (s := s) T v).neg_mem hlow

/-- The orbit span is invariant under `T` once the final power reduces. -/
theorem actualGreedyOrbitSpan_invariant
    {n s : Nat} (T : Module.End (ZMod 2) (BinaryVector n))
    (v : BinaryVector n)
    (hlast : (T ^ s) v ∈ actualGreedyOrbitSpan (s := s) T v) :
    ∀ x, x ∈ actualGreedyOrbitSpan (s := s) T v →
      T x ∈ actualGreedyOrbitSpan (s := s) T v := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    rcases hy with ⟨i, rfl⟩
    change T ((T ^ i.val) v) ∈ actualGreedyOrbitSpan (s := s) T v
    have hpow : T ((T ^ i.val) v) = (T ^ (i.val + 1)) v := by
      rw [pow_succ']
      rfl
    by_cases hi : i.val + 1 < s
    · let j : Fin s := ⟨i.val + 1, hi⟩
      rw [hpow]
      exact Submodule.subset_span ⟨j, by simp [actualGreedyOrbitFamily, j]⟩
    · have heq : i.val + 1 = s := by omega
      rw [hpow, heq]
      exact hlast
  | zero => simp
  | add y z hy hz ihy ihz =>
    simpa only [map_add] using (actualGreedyOrbitSpan (s := s) T v).add_mem ihy ihz
  | smul a y hy ih =>
    rw [map_smul]
    exact (actualGreedyOrbitSpan (s := s) T v).smul_mem a ih

/-- The accepted finite-array selector supplies a real fresh physical unit;
the quotient-orbit theorem then proves exact abstract dimension growth and
invariance for adjoining its orbit. This is the mathematical one-step bridge
for the three-pass constructor. It does not yet prove that the returned
`Array ++ orbit` has exactly this sup as its column submodule. -/
theorem actualGreedyArraySelectedOrbit_step
    {s : Nat} (T : Module.End (ZMod 2) (BinaryVector (3 * s)))
    (columns : Array (BinaryVector (3 * s))) (p : Polynomial (ZMod 2))
    (hs : 1 ≤ s) (hpdeg : p.natDegree = s) (hirr : Irreducible p)
    (hmonic : p.Monic) (hroot : Polynomial.aeval T p = 0)
    (hT : ∀ x, x ∈ actualGreedyArrayColumnSubmodule columns →
      T x ∈ actualGreedyArrayColumnSubmodule columns)
    (hproper : actualGreedyArrayColumnSubmodule columns ≠ ⊤) :
    ∃ i : Fin (3 * s),
      actualGreedyArrayFirstUnitOutside? columns = some i ∧
      actualGreedyArrayUnitVector i ∉ actualGreedyArrayColumnSubmodule columns ∧
      Module.finrank (ZMod 2)
          (show Submodule (ZMod 2) (BinaryVector (3 * s)) from
            actualGreedyArrayColumnSubmodule columns ⊔
              actualGreedyOrbitSpan (s := s) T (actualGreedyArrayUnitVector i)) =
        Module.finrank (ZMod 2) (actualGreedyArrayColumnSubmodule columns) + s ∧
      (∀ x, x ∈ actualGreedyArrayColumnSubmodule columns ⊔
          actualGreedyOrbitSpan (s := s) T (actualGreedyArrayUnitVector i) →
        T x ∈ actualGreedyArrayColumnSubmodule columns ⊔
          actualGreedyOrbitSpan (s := s) T (actualGreedyArrayUnitVector i)) := by
  obtain ⟨i, hselected, houtside⟩ :=
    actualGreedyArrayFirstUnitOutside?_some_of_proper columns hproper
  have hquot := actualGreedyQuotientOrbit_independent T
    (actualGreedyArrayColumnSubmodule columns)
    (actualGreedyArrayUnitVector i) p hs hpdeg hirr hroot hT houtside
  have hlast := actualGreedyOrbit_last_mem_span T
    (actualGreedyArrayUnitVector i) p hmonic hpdeg hroot
  have hdim := actualGreedyOrbitAppend_finrank T
    (actualGreedyArrayColumnSubmodule columns)
    (actualGreedyArrayUnitVector i) hquot.1
  have horbitInv := actualGreedyOrbitSpan_invariant T
    (actualGreedyArrayUnitVector i) hlast
  have hnewInv : ∀ x,
      x ∈ actualGreedyArrayColumnSubmodule columns ⊔
        actualGreedyOrbitSpan (s := s) T (actualGreedyArrayUnitVector i) →
      T x ∈ actualGreedyArrayColumnSubmodule columns ⊔
        actualGreedyOrbitSpan (s := s) T (actualGreedyArrayUnitVector i) := by
    intro x hx
    rcases Submodule.mem_sup.mp hx with ⟨a, ha, b, hb, hab⟩
    rw [← hab, map_add]
    exact (actualGreedyArrayColumnSubmodule columns ⊔
      actualGreedyOrbitSpan (s := s) T (actualGreedyArrayUnitVector i)).add_mem
      (Submodule.mem_sup_left (hT a ha))
      (Submodule.mem_sup_right (horbitInv b hb))
  exact ⟨i, hselected, houtside, hdim, hnewInv⟩

end CorruptedFieldRecovery
