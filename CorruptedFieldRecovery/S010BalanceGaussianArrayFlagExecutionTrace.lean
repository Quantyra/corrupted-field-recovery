import CorruptedFieldRecovery.S010BalanceGaussianArrayFlagScan

namespace CorruptedFieldRecovery

/-- Events recorded by the Boolean-flag implementation. Selector counters
are generated by the executed recursive predicate, rather than supplied as
dimension parameters. The pivot-update counters are conservative source-level
charges for the existing `Array.ofFn` update primitive. -/
structure ActualBalanceGaussianFlagExecutionTrace where
  columnsProcessed : Nat
  rowIndexListNodes : Nat
  selectorPredicateTests : Nat
  booleanFlagReads : Nat
  selectorCoefficientViews : Nat
  pivotUpdates : Nat
  pivotCoefficientViewsUpper : Nat
  pivotRowComparisons : Nat
  fieldMultiplicationsUpper : Nat
  fieldAdditionsUpper : Nat
  coefficientCellWrites : Nat
  matrixRowArrayWrites : Nat
  flagUpdateReadsUpper : Nat
  flagCellComparisons : Nat
  flagCellWrites : Nat
  newMatrixArraySlots : Nat
  newFlagArraySlots : Nat
  initialFlagArraySlots : Nat
  initialFlagCellWrites : Nat
  transcriptCons : Nat
  columnListNodes : Nat
  deriving DecidableEq, Repr

def actualBalanceGaussianFlagExecutionTrace.zero :
    ActualBalanceGaussianFlagExecutionTrace :=
  { columnsProcessed := 0
    rowIndexListNodes := 0
    selectorPredicateTests := 0
    booleanFlagReads := 0
    selectorCoefficientViews := 0
    pivotUpdates := 0
    pivotCoefficientViewsUpper := 0
    pivotRowComparisons := 0
    fieldMultiplicationsUpper := 0
    fieldAdditionsUpper := 0
    coefficientCellWrites := 0
    matrixRowArrayWrites := 0
    flagUpdateReadsUpper := 0
    flagCellComparisons := 0
    flagCellWrites := 0
    newMatrixArraySlots := 0
    newFlagArraySlots := 0
    initialFlagArraySlots := 0
    initialFlagCellWrites := 0
    transcriptCons := 0
    columnListNodes := 0 }

def actualBalanceGaussianFlagExecutionTrace.add
    (a b : ActualBalanceGaussianFlagExecutionTrace) :
    ActualBalanceGaussianFlagExecutionTrace :=
  { columnsProcessed := a.columnsProcessed + b.columnsProcessed
    rowIndexListNodes := a.rowIndexListNodes + b.rowIndexListNodes
    selectorPredicateTests := a.selectorPredicateTests + b.selectorPredicateTests
    booleanFlagReads := a.booleanFlagReads + b.booleanFlagReads
    selectorCoefficientViews := a.selectorCoefficientViews + b.selectorCoefficientViews
    pivotUpdates := a.pivotUpdates + b.pivotUpdates
    pivotCoefficientViewsUpper := a.pivotCoefficientViewsUpper + b.pivotCoefficientViewsUpper
    pivotRowComparisons := a.pivotRowComparisons + b.pivotRowComparisons
    fieldMultiplicationsUpper := a.fieldMultiplicationsUpper + b.fieldMultiplicationsUpper
    fieldAdditionsUpper := a.fieldAdditionsUpper + b.fieldAdditionsUpper
    coefficientCellWrites := a.coefficientCellWrites + b.coefficientCellWrites
    matrixRowArrayWrites := a.matrixRowArrayWrites + b.matrixRowArrayWrites
    flagUpdateReadsUpper := a.flagUpdateReadsUpper + b.flagUpdateReadsUpper
    flagCellComparisons := a.flagCellComparisons + b.flagCellComparisons
    flagCellWrites := a.flagCellWrites + b.flagCellWrites
    newMatrixArraySlots := a.newMatrixArraySlots + b.newMatrixArraySlots
    newFlagArraySlots := a.newFlagArraySlots + b.newFlagArraySlots
    initialFlagArraySlots := a.initialFlagArraySlots + b.initialFlagArraySlots
    initialFlagCellWrites := a.initialFlagCellWrites + b.initialFlagCellWrites
    transcriptCons := a.transcriptCons + b.transcriptCons
    columnListNodes := a.columnListNodes + b.columnListNodes }

/-- The source-level charge attached to an execution trace. Each array view
is charged for two safe indexed reads. Row-update arithmetic and writes are
upper charges. This is not a Lean evaluator or machine-word cost theorem. -/
def actualBalanceGaussianFlagExecutionTrace.sourceOperationUpper
    (t : ActualBalanceGaussianFlagExecutionTrace) : Nat :=
  t.rowIndexListNodes + t.columnsProcessed + t.selectorPredicateTests +
    t.booleanFlagReads + t.flagUpdateReadsUpper +
    2 * t.selectorCoefficientViews + 2 * t.pivotCoefficientViewsUpper +
    t.pivotRowComparisons + t.fieldMultiplicationsUpper +
    t.fieldAdditionsUpper + t.coefficientCellWrites +
    t.matrixRowArrayWrites + t.flagCellComparisons + t.flagCellWrites +
    t.initialFlagCellWrites + t.transcriptCons + t.pivotUpdates +
    t.columnListNodes

def actualBalanceGaussianFlagExecutionTrace.cumulativeArraySlots
    (t : ActualBalanceGaussianFlagExecutionTrace) : Nat :=
  t.initialFlagArraySlots + t.newMatrixArraySlots + t.newFlagArraySlots

def actualBalanceGaussianFlagExecutionTrace.cumulativeListSlots
    (t : ActualBalanceGaussianFlagExecutionTrace) : Nat :=
  t.rowIndexListNodes + t.columnListNodes + t.transcriptCons

/-- One predicate probe for an already-used row. It reads the flag and tests
the masked zero against one, but does not read a matrix coefficient. -/
def actualBalanceGaussianFlagUsedProbe : ActualBalanceGaussianFlagExecutionTrace :=
  { actualBalanceGaussianFlagExecutionTrace.zero with
    selectorPredicateTests := 1
    booleanFlagReads := 1 }

/-- One predicate probe for a fresh row. -/
def actualBalanceGaussianFlagFreshProbe : ActualBalanceGaussianFlagExecutionTrace :=
  { actualBalanceGaussianFlagExecutionTrace.zero with
    selectorPredicateTests := 1
    booleanFlagReads := 1
    selectorCoefficientViews := 1 }

/-- Recursive counted first-match search using the same branch conditions as
`actualBalanceGaussianFlagFirstUnusedPivotRow`. The trace reports the actual
number of candidate predicates evaluated; it stops at the first pivot. -/
def actualBalanceGaussianFlagCountedFindUnusedRow {m n : Nat}
    (cells : Array (Array (ZMod 2))) (flags : Array Bool)
    (column : Fin n) : List (Fin m) →
      Option (Fin m) × ActualBalanceGaussianFlagExecutionTrace
  | [] => (none, actualBalanceGaussianFlagExecutionTrace.zero)
  | row :: rows =>
      if actualBalanceGaussianUsedFlagView flags row then
        let rest := actualBalanceGaussianFlagCountedFindUnusedRow
          cells flags column rows
        (rest.1, actualBalanceGaussianFlagExecutionTrace.add
          actualBalanceGaussianFlagUsedProbe rest.2)
      else if actualBalanceGaussianArrayView cells row column = 1 then
        (some row, actualBalanceGaussianFlagFreshProbe)
      else
        let rest := actualBalanceGaussianFlagCountedFindUnusedRow
          cells flags column rows
        (rest.1, actualBalanceGaussianFlagExecutionTrace.add
          actualBalanceGaussianFlagFreshProbe rest.2)

private theorem actualBalanceGaussianFlagCountedFindUnusedRow_eq_find?
    {m n : Nat} (cells : Array (Array (ZMod 2))) (flags : Array Bool)
    (column : Fin n) (rows : List (Fin m)) :
    (actualBalanceGaussianFlagCountedFindUnusedRow
      cells flags column rows).1 =
      rows.find? (fun row => decide
        ((if actualBalanceGaussianUsedFlagView flags row then
          (0 : ZMod 2) else actualBalanceGaussianArrayView cells row column) = 1)) := by
  induction rows with
  | nil => rfl
  | cons row rows ih =>
      by_cases hflag : actualBalanceGaussianUsedFlagView flags row
      · simp [actualBalanceGaussianFlagCountedFindUnusedRow, hflag,
          actualBalanceGaussianFlagExecutionTrace.add, ih, List.find?]
      · by_cases hvalue : actualBalanceGaussianArrayView cells row column = 1
        · simp [actualBalanceGaussianFlagCountedFindUnusedRow, hflag, hvalue,
            actualBalanceGaussianFlagFreshProbe, List.find?]
        · simp [actualBalanceGaussianFlagCountedFindUnusedRow, hflag, hvalue,
            actualBalanceGaussianFlagExecutionTrace.add,
            actualBalanceGaussianFlagFreshProbe, ih, List.find?]

/-- Counted form of the actual selector. Constructing the row list costs `m`
list cells even if the search returns at an earlier row. -/
def actualBalanceGaussianFlagCountedFirstUnusedPivotRow {m n : Nat}
    (cells : Array (Array (ZMod 2))) (flags : Array Bool)
    (column : Fin n) : Option (Fin m) × ActualBalanceGaussianFlagExecutionTrace :=
  let rows := List.ofFn fun row : Fin m => row
  let result := actualBalanceGaussianFlagCountedFindUnusedRow
    cells flags column rows
  (result.1, actualBalanceGaussianFlagExecutionTrace.add
    { actualBalanceGaussianFlagExecutionTrace.zero with rowIndexListNodes := m }
    result.2)

theorem actualBalanceGaussianFlagCountedFirstUnusedPivotRow_eq
    {m n : Nat} (cells : Array (Array (ZMod 2))) (flags : Array Bool)
    (column : Fin n) :
    (actualBalanceGaussianFlagCountedFirstUnusedPivotRow
      cells flags column).1 =
      actualBalanceGaussianFlagFirstUnusedPivotRow m cells flags column := by
  rw [actualBalanceGaussianFlagCountedFirstUnusedPivotRow,
    actualBalanceGaussianFlagCountedFindUnusedRow_eq_find?]
  simp [actualBalanceGaussianFlagFirstUnusedPivotRow]

/-- Upper charges for one matrix pivot update and one flag-array rebuild.
`SetUsedFlag` compares and writes `m` positions and reads the old flag at all
non-pivot positions; `m` is charged as a safe upper bound on those reads. -/
def actualBalanceGaussianFlagPivotUpdateCharge (m n : Nat) :
    ActualBalanceGaussianFlagExecutionTrace :=
  { actualBalanceGaussianFlagExecutionTrace.zero with
    pivotUpdates := 1
    pivotCoefficientViewsUpper := 3 * m * n
    pivotRowComparisons := m * n
    fieldMultiplicationsUpper := m * n
    fieldAdditionsUpper := m * n
    coefficientCellWrites := m * n
    matrixRowArrayWrites := m
    flagUpdateReadsUpper := m
    flagCellComparisons := m
    flagCellWrites := m
    newMatrixArraySlots := m * (n + 1)
    newFlagArraySlots := m
    transcriptCons := 1 }

abbrev ActualBalanceGaussianFlagScanOutput (m n : Nat) :=
  (Array (Array (ZMod 2)) × Array Bool) × List (Fin m × Fin n)

/-- Instrumented flag-array column scan. Its value follows the same selector,
matrix update, flag update, and transcript branches as the uninstrumented
scan; its trace accumulates selector observations and per-pivot upper charges. -/
def actualBalanceGaussianFlagColumnScanInstrumented {m n : Nat}
    (cells : Array (Array (ZMod 2))) : Array Bool → List (Fin n) →
      ActualBalanceGaussianFlagScanOutput m n ×
        ActualBalanceGaussianFlagExecutionTrace
  | flags, [] =>
      (((cells, flags), []), actualBalanceGaussianFlagExecutionTrace.zero)
  | flags, column :: columns =>
      let selected := actualBalanceGaussianFlagCountedFirstUnusedPivotRow
        cells flags column
      match selected.1 with
      | none =>
          let rest := actualBalanceGaussianFlagColumnScanInstrumented
            cells flags columns
          (rest.1, actualBalanceGaussianFlagExecutionTrace.add selected.2
            (actualBalanceGaussianFlagExecutionTrace.add
              { actualBalanceGaussianFlagExecutionTrace.zero with columnsProcessed := 1 }
              rest.2))
      | some row =>
          let rest := actualBalanceGaussianFlagColumnScanInstrumented
            (actualBalanceGaussianArrayPivotRow cells row column)
            (actualBalanceGaussianSetUsedFlag flags row) columns
          ((((rest.1.1.1, rest.1.1.2), (row, column) :: rest.1.2)),
            actualBalanceGaussianFlagExecutionTrace.add selected.2
              (actualBalanceGaussianFlagExecutionTrace.add
                (actualBalanceGaussianFlagPivotUpdateCharge m n)
                (actualBalanceGaussianFlagExecutionTrace.add
                  { actualBalanceGaussianFlagExecutionTrace.zero with
                    columnsProcessed := 1 } rest.2)))

/-- The instrumented scan changes no result: its output is exactly the
uninstrumented Boolean-flag scan. -/
theorem actualBalanceGaussianFlagColumnScanInstrumented_refines
    {m n : Nat} (cells : Array (Array (ZMod 2))) (flags : Array Bool)
    (columns : List (Fin n)) :
    (actualBalanceGaussianFlagColumnScanInstrumented cells flags columns).1 =
      actualBalanceGaussianFlagColumnScan m cells flags columns := by
  induction columns generalizing cells flags with
  | nil => rfl
  | cons column columns ih =>
      let selected := actualBalanceGaussianFlagCountedFirstUnusedPivotRow
        (m := m) cells flags column
      have hselected := actualBalanceGaussianFlagCountedFirstUnusedPivotRow_eq
        (m := m) cells flags column
      cases h : selected.1 with
      | none =>
          have harray :
              actualBalanceGaussianFlagFirstUnusedPivotRow m cells flags column = none := by
            rw [← hselected, h]
          simpa [actualBalanceGaussianFlagColumnScanInstrumented,
            actualBalanceGaussianFlagColumnScan, selected, h, harray] using
              ih cells flags
      | some row =>
          have harray :
              actualBalanceGaussianFlagFirstUnusedPivotRow m cells flags column = some row := by
            rw [← hselected, h]
          have hres := ih (actualBalanceGaussianArrayPivotRow cells row column)
            (actualBalanceGaussianSetUsedFlag flags row)
          simp only [actualBalanceGaussianFlagColumnScanInstrumented,
            actualBalanceGaussianFlagColumnScan, selected, h, harray]
          simpa using Prod.ext_iff.mp hres

/-- Raw serialized execution, including the initial all-false flag array and
the input column-list allocation in its trace. Matrix/tensor construction is
outside this scan and is not charged here. -/
def actualBalanceGaussianSerializedArrayFlagScanInstrumented {s : Nat}
    (raw : RawCoefficientArray) (tape : FiveWordTape s) :=
  let m := 4 * ((3 * s) * (3 * s))
  let k := (3 * s) * (3 * s)
  let cells := actualBalanceSerializedCoefficientMatrix
    (decodeRawArray (n := 3 * s) raw) tape
  let flags := actualBalanceGaussianEmptyUsedFlags m
  let columns := List.ofFn fun column : Fin k => column
  let run := actualBalanceGaussianFlagColumnScanInstrumented (m := m) cells flags columns
  (run.1, { run.2 with
    columnListNodes := k
    initialFlagArraySlots := m
    initialFlagCellWrites := m })

/-- The raw instrumented execution projects to the same matrix view and pivot
transcript as the existing raw flag scan. -/
theorem actualBalanceGaussianSerializedArrayFlagScanInstrumented_refines
    {s : Nat} (raw : RawCoefficientArray) (tape : FiveWordTape s) :
    (actualBalanceGaussianArrayView
      (actualBalanceGaussianSerializedArrayFlagScanInstrumented raw tape).1.1.1,
      (actualBalanceGaussianSerializedArrayFlagScanInstrumented raw tape).1.2) =
      actualBalanceGaussianRawScan raw tape := by
  let m := 4 * ((3 * s) * (3 * s))
  let cells := actualBalanceSerializedCoefficientMatrix
    (decodeRawArray (n := 3 * s) raw) tape
  let flags := actualBalanceGaussianEmptyUsedFlags m
  let columns := List.ofFn fun column : Fin ((3 * s) * (3 * s)) => column
  have hscan := actualBalanceGaussianFlagColumnScanInstrumented_refines
    (m := m) cells flags columns
  have hprojected :
      (actualBalanceGaussianArrayView
        (actualBalanceGaussianFlagColumnScanInstrumented
          (m := m) cells flags columns).1.1.1,
        (actualBalanceGaussianFlagColumnScanInstrumented
          (m := m) cells flags columns).1.2) =
        (actualBalanceGaussianArrayView
          (actualBalanceGaussianFlagColumnScan m cells flags columns).1.1,
          (actualBalanceGaussianFlagColumnScan m cells flags columns).2) :=
    congrArg (fun out : (Array (Array (ZMod 2)) × Array Bool) ×
        List (Fin m × Fin ((3 * s) * (3 * s))) =>
      (actualBalanceGaussianArrayView (m := m) (n := (3 * s) * (3 * s)) out.1.1,
        out.2)) hscan
  have hflag := actualBalanceGaussianSerializedArrayFlagScan_refines raw tape
  simpa [actualBalanceGaussianSerializedArrayFlagScanInstrumented,
    m, cells, flags, columns] using hprojected.trans hflag

/-! Expected event-trace bound for the raw wrapper, using `d=3*s`. The trace is
coupled to the executed selector and scan. The conservative component charges
are: three matrix views, two arithmetic operations, one cell write, and one
row comparison per pivoted cell; and one comparison/write plus at most one old
flag read per flag position. It also counts a pivot-update call separately
from the per-column scan step. With `m=4*d^2`, `k=n=d^2`, and `p≤k`,
componentwise bounds would give `40*d^6 + 36*d^4 + 8*d^2`. This draft
provides the execution trace and result projection, but does not prove those
aggregate componentwise inequalities. It excludes matrix construction,
runtime headers/GC/stack, and bit complexity. -/

end CorruptedFieldRecovery
